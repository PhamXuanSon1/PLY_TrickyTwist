MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4780056824356786650}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7158162c194277e4d84a2667b1f55bf4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  levelType: 1
  progressUIType: 7
  levelID: 52
  hasTimer: 1
  totalTime: 180
  hints:
  - stepHandle: {fileID: 7553847281885983993}
    localizeKey: hint_lv52_milk
    vi: "Drag Milk carton cho  cho ng\u01B0\u1EDDi ph\u1EE5 n\u1EEF"
    en: Pull the milk carton for the woman
  - stepHandle: {fileID: 5788694003370878901}
    localizeKey: hint_lv52_fruit
    vi: "Drag ly n\u01B0\u1EDBc cam cho ng\u01B0\u1EDDi ph\u1EE5 n\u1EEF"
    en: Pour a glass of orange juice for the woman
  - stepHandle: {fileID: 704740059278212536}
    localizeKey: hint_lv52_bottle
    vi: "Ch\u1EA1m vao t\u1EE7 l\u1EA1nh \u0111\u1EC3 m\u1EDF n\xF3, sau \u0111\xF3
      drag chai n\u01B0\u1EDBc cho ng\u01B0\u1EDDi ph\u1EE5 n\u1EEF"
    en: Touch the refrigerator to open it, then drag the bottle of water for the
      woman
  - stepHandle: {fileID: 5534921685974943931}
    localizeKey: hint_lv52_icream
    vi: "Drag kem trong t\u1EE7 l\u1EA1nh cho ng\u01B0\u1EDDi ph\u1EE5 n\u1EEF"
    en: Keep the cream in the refrigerator for women
  - stepHandle: {fileID: 8080312704100123642}
    localizeKey: hint_lv52_icecup
    vi: "Drag c\u1ED1c n\u01B0\u1EDBc \u0111\xE1 trong t\u1EE7 l\u1EA1nh cho ng\u01B0\u1EDDi
      ph\u1EE5 n\u1EEF"
    en: Pull out a glass of ice water from the refrigerator for the woman
  - stepHandle: {fileID: 1601631426844579221}
    localizeKey: hint_lv52_tofu
    vi: "Drag \u0111\u1EADu ph\u1EE5 v\xE0o n\u1ED3i l\u1EA9u \u0111\u1EC3 gi\u1EA3m
      \u0111\u1ED9 cay"
    en: Add tofu to the hotpot to reduce spiciness
  - stepHandle: {fileID: 1773211100854713554}
    localizeKey: hint_lv52_orion
    vi: "Drag h\xE0nh cho c\xF4 g\xE1i \u0103n"
    en: Drag for the girl to eat
  - stepHandle: {fileID: 1493687588153475095}
    localizeKey: hint_lv52_water
    vi: "\u0110\u1ED5 n\u01B0\u1EDBc t\u1EEB b\xECnh n\u01B0\u1EDBc tr\xEAn b\xE0n
      v\xE0o n\u1ED3i l\u1EA9u"
    en: Pour water from the water jug on the table into the hotpot.
  - stepHandle: {fileID: 1632676271374898173}
    localizeKey: hint_lv52_ladle
    vi: "Drag ladle v\xE0o n\u1ED3i n\u1EA9u \u0111\u1EC3 v\u1EDBt b\u1ECF \u1EDBt"
    en: Drag the ladle into the pot to remove the chili peppers
  - stepHandle: {fileID: 6613616023928498587}
    localizeKey: hint_lv52_shirt
    vi: "Swipe up v\xE0o \xE1o c\u1EE7a ng\u01B0\u1EDDi \u0111\xE0n \xF4ng"
    en: Swipe up on the man's shirt
  delayShowWin: 0
--- !u!114 &1016757973086042584
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4780056824356786650}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 941934a0650ca824f885ee3495e23922, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  startVoice:
    localizeKey: voice_lv52
    vi: "Cay, cay, cay qu\xE1,... gi\xFAp em v\u1EDBi"
    en: Spicy, spicy, too spicy,... help me please
  listVoice:
  - stepHandle: {fileID: 7553847281885983993}
    showVoiceType: 0
    localizeData:
      localizeKey: voice_lv52_milk
      vi: "S\u1EEFa c\xF3 th\u1EC3 gi\xFAp gi\u1EA3m v\u1ECB cay"
      en: Milk can help reduce spiciness
  - stepHandle: {fileID: 704740059278212536}
    showVoiceType: 1
    localizeData:
      localizeKey: voice_lv52_bottle
      vi: "T\xF4i mu\u1ED1n u\u1ED1ng th\xEAm"
      en: I want to drink more
  - stepHandle: {fileID: 5534921685974943931}
    showVoiceType: 0
    localizeData:
      localizeKey: voice_lv52_icream
      vi: "Kem n\xE0y ngon qu\xE1."
      en: This ice cream is so delicious.
  - stepHandle: {fileID: 8080312704100123642}
    showVoiceType: 0
    localizeData:
      localizeKey: voice_lv52_icecup
      vi: "\u0110\xE1 c\xF3 th\u1EC3 l\xE0m gi\u1EA3m \u0111\u1ED9 cay"
      en: Stones can reduce spiciness
  - stepHandle: {fileID: 5788694003370878901}
    showVoiceType: 0
    localizeData:
      localizeKey: voice_lv52_fruit
      vi: "Cho t\xF4i c\u1ED1c n\u01B0\u1EDBc cam n\xE0y."
      en: Give me this glass of orange juice.
  - stepHandle: {fileID: 1601631426844579221}
    showVoiceType: 0
    localizeData:
      localizeKey: voice_lv52_tofu
      vi: "Cho th\xEAm \u0111\u1EADu ph\u1EE5 v\xE0o \u0111\u1EC3 gi\u1EA3m cay"
      en: Add more tofu to reduce spiciness
  - stepHandle: {fileID: 1493687588153475095}
    showVoiceType: 0
    localizeData:
      localizeKey: voice_lv52_water
      vi: "\u0110\u1ED5 th\xEAm n\u01B0\u1EDBc v\xE0o n\u1ED3i"
      en: Pour more water into the pot
  - stepHandle: {fileID: 1632676271374898173}
    showVoiceType: 0
    localizeData:
      localizeKey: voice_lv52_ladle
      vi: "L\u1EA5y b\u1EDBt \u1EDBt trong n\u1ED3i ra"
      en: Take out some chili from the pot
  - stepHandle: {fileID: 6613616023928498587}
    showVoiceType: 0
    localizeData:
      localizeKey: voice_lv52_shirt
      vi: "H\xE3y k\xE9o \xE1o c\u1EE7a anh l\xEAn"
      en: Pull up your shirt
