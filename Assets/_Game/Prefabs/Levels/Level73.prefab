  hints:
  - stepHandle: {fileID: 3627809884917435634}
    localizeKey: hint_lv73_curtain_switch
    vi: "Ch\u1EA1m v\xE0o c\xF4ng t\xE1c \u0111i\u1EC1u khi\u1EC3n"
    en: Touch the control work
  - stepHandle: {fileID: 2831705999903652703}
    localizeKey: hint_lv73_curtain01_scissors
    vi: "Drag c\xE1i k\xE9o v\xE0o curtain"
    en: Drag the scissors onto the curtain
  - stepHandle: {fileID: 6119810413330625803}
    localizeKey: hint_lv73_curtain01_lighter
    vi: "Drag b\u1EADt l\u1EEDa trong t\xFAi qu\u1EA7n ng\u01B0\u1EDDi \u0111\xE0n
      \xF4ng v\xE0o curtain"
    en: Pulling a lighter out of the man's pants pocket behind the curtain
  - stepHandle: {fileID: 2842266304622374495}
    localizeKey: hint_lv73_curtain01_fan
    vi: "Drag c\xE1i qu\u1EA1t v\xE0o curtain"
    en: Pull the fan towards the curtain
  - stepHandle: {fileID: 6846736219294753292}
    localizeKey: hint_lv73_curtain01_bee
    vi: "Drag c\xE2y kem tr\xEAn tay ng\u01B0\u1EDDi \u0111\xE0n \xF4ng v\xE0o curtain"
    en: Drag the ice cream tree on the man's hand into the curtain
  - stepHandle: {fileID: 4481024103956324043}
    localizeKey: hint_lv73_curtain_dog
    vi: "Drag x\xFAc x\xEDch tr\xEAn b\xE0n v\xE0o curtain"
    en: Pull the sausage on the table towards the curtain
  - stepHandle: {fileID: 1167218302963196976}
    localizeKey: hint_lv73_curtain_water
    vi: "Drag cu\u1ED9n \u1ED1ng n\u01B0\u1EDBc v\xE0o curtain"
    en: Pull the water hose into the curtain
  - stepHandle: {fileID: 7140001052748169861}
    localizeKey: hint_lv73_curtain_hand
    vi: "Drag b\xE0n tay c\u1EE7a ng\u01B0\u1EDDi \u0111\xE0n \xF4ng \u1EDF gi\u1EEFa
      v\xE0o curtain"
    en: Pull the man's hand in the middle into the curtain
  delayShowWin: 0
